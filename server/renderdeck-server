#!/usr/bin/env python3
"""
renderdeck-server — one place to see every render across every machine.

Runs on the VPS. Agents on Rynn / Emmett / Asmond POST their current job state;
this keeps the latest snapshot per machine plus a history of finished jobs, and
serves a dashboard.

Push, not poll, deliberately: the render machines sleep, change IPs, and sit
behind NAT. A collector that polls them is wrong half the time. A machine that
hasn't reported in --stale-seconds is shown as offline rather than silently
dropped, so "nothing rendering" and "we lost contact" never look the same —
which is the same class of mistake as reading a finished render as a dead one.

    renderdeck-server --bind 0.0.0.0 --port 8090

Endpoints
    POST /api/report   {machine, app, jobs:[...]}   Bearer token
    GET  /api/state    combined JSON
    GET  /             dashboard
    GET  /healthz      liveness for Gatus

Job shape (the common model every adapter emits):
    {id, name, state, percent, elapsed_s, output, error}
    state: rendering | complete | failed | cancelled | stalled
"""

import argparse
import json
import os
import sqlite3
import time
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

DB = os.environ.get("RENDERDECK_DB") or os.path.expanduser(
    "~/.local/share/renderdeck/state.db")

# Removing a machine that will never report again (a decommissioned box, or a
# probe row from testing). Without this the only way out was hand-editing
# SQLite on the server, which I did twice before writing it.
TOKEN = os.environ.get("RENDERDECK_TOKEN", "")
STALE = 180

# Optional brand mark. Ships as assets/logo.svg.example so the public repo
# isn't hardcoded to anyone's wordmark: drop your own assets/logo.svg (or set
# RENDERDECK_LOGO) and the header uses it, otherwise it falls back to the text
# wordmark. Same pattern ResolveRenderMonitor uses for its logo slot.
_ASSETS = os.path.join(os.path.dirname(os.path.abspath(__file__)), "assets")
LOGO = os.environ.get("RENDERDECK_LOGO") or os.path.join(_ASSETS, "logo.svg")

# Home-screen icon. Without an explicit apple-touch-icon iOS renders a
# screenshot of the page or a bare letter tile — a web clip added to the home
# screen showed a generic "R". Served alongside the logo so a deployment can
# brand both.
STATIC = {
    "/logo.svg":              (LOGO, "image/svg+xml"),
    "/apple-touch-icon.png":  (os.path.join(_ASSETS, "apple-touch-icon.png"), "image/png"),
    "/icon-512.png":          (os.path.join(_ASSETS, "icon-512.png"), "image/png"),
}

ACTIVE = {"rendering", "stalled"}


def db():
    os.makedirs(os.path.dirname(DB), exist_ok=True)
    c = sqlite3.connect(DB, timeout=10)
    # Keyed on (machine, app), NOT machine alone. A machine runs a watcher per
    # program, so Asmond reporting Resolve must not overwrite Asmond reporting
    # After Effects -- with machine as the primary key the two watchers silently
    # clobbered each other and the dashboard showed whichever reported last.
    c.execute("""CREATE TABLE IF NOT EXISTS snapshot(
        machine TEXT, app TEXT, jobs TEXT, ts REAL,
        PRIMARY KEY (machine, app))""")
    # UNIQUE includes APP. Without it, AE and Resolve on one machine emitting
    # the same job_id collide and the second app's row is silently ignored --
    # data loss that looks like "the render just didn't get logged".
    c.execute("""CREATE TABLE IF NOT EXISTS history(
        id INTEGER PRIMARY KEY AUTOINCREMENT, machine TEXT, app TEXT,
        job_id TEXT, name TEXT, state TEXT, elapsed_s REAL, output TEXT,
        error TEXT, ts REAL, UNIQUE(machine, app, job_id, state))""")
    return c


def record(machine, app, jobs):
    c = db()
    now = time.time()
    c.execute("REPLACE INTO snapshot(machine,app,jobs,ts) VALUES(?,?,?,?)",
              (machine, app, json.dumps(jobs), now))
    for j in jobs:
        if j.get("state") in ("complete", "failed", "cancelled"):
            # UNIQUE(machine, app, job_id, state) prevents duplicates. Refresh
            # metadata on later reports so adapter improvements (for example,
            # replacing Resolve's generic `Job 1` with the output filename)
            # repair existing history without rewriting its original timestamp.
            c.execute("INSERT OR IGNORE INTO history"
                      "(machine,app,job_id,name,state,elapsed_s,output,error,ts)"
                      " VALUES(?,?,?,?,?,?,?,?,?)",
                      (machine, app, j.get("id"), j.get("name"), j.get("state"),
                       j.get("elapsed_s"), j.get("output"), j.get("error"), now))
            c.execute("UPDATE history SET name=?,elapsed_s=?,output=?,error=?"
                      " WHERE machine=? AND app=? AND job_id=? AND state=?",
                      (j.get("name"), j.get("elapsed_s"), j.get("output"),
                       j.get("error"), machine, app, j.get("id"), j.get("state")))
    c.commit()
    c.close()


def state():
    c = db()
    now = time.time()
    machines = []
    for machine, app, jobs, ts in c.execute(
            "SELECT machine,app,jobs,ts FROM snapshot ORDER BY machine, app"):
        age = now - ts
        machines.append({
            "machine": machine, "app": app, "age_s": round(age),
            "online": age < STALE,
            "jobs": json.loads(jobs) if age < STALE else [],
        })
    hist = [dict(zip(("machine", "app", "name", "state", "elapsed_s", "output", "ts"), r))
            for r in c.execute("SELECT machine,app,name,state,elapsed_s,output,ts"
                               " FROM history ORDER BY ts DESC LIMIT 25")]
    c.close()
    active = sum(1 for m in machines for j in m["jobs"] if j.get("state") in ACTIVE)
    # Expose the count a monitor actually wants to assert on. Making Gatus
    # express "every machine is online" in JSONPath was fragile and silently
    # evaluated false; `offline == 0` is unambiguous and self-documenting.
    offline = sum(1 for m in machines if not m["online"])
    return {"machines": machines, "history": hist, "active": active,
            "offline": offline, "now": now}


