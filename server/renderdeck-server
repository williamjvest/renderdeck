        <div class="w-full bg-zinc-950 rounded-full h-1.5 overflow-hidden border border-zinc-800">
          <div class="${st?'bg-amber-500':'bg-orange-500'} h-1.5 rounded-full transition-all duration-500" style="width:${j.percent||0}%"></div>
        </div>
        ${j.output?`<div class="text-xs text-zinc-600 mt-1 truncate">${esc(base(j.output))}</div>`:''}</td>
      <td class="p-3 text-right text-zinc-400 tabular-nums whitespace-nowrap">${dur(j.elapsed_s)}</td></tr>`
  }).join(''):'<tr><td colspan=4 class="p-6 text-center text-zinc-600">Nothing rendering</td></tr>';

  const term=(document.getElementById('q').value||'').toLowerCase();
  const sf=document.getElementById('sf').value;
  const rows=D.history.filter(r=>(sf==='ALL'||r.state===sf)&&
    (!term||`${r.name} ${r.machine} ${r.output||''}`.toLowerCase().includes(term)));
  const cls={complete:'text-emerald-400',failed:'text-red-400',cancelled:'text-zinc-500'};
  document.getElementById('hist').innerHTML = rows.length?rows.map(r=>
    `<tr class="hover:bg-zinc-950/50"><td class="p-3 text-zinc-500 whitespace-nowrap">${clock(r.ts)}</td>
     <td class="p-3 text-zinc-400">${esc(r.machine)}</td>
     <td class="p-3 truncate max-w-[16rem]">${esc(r.name)}</td>
     <td class="p-3 font-medium ${cls[r.state]||'text-zinc-400'}">${esc(r.state)} <span class="text-zinc-600 font-normal">${dur(r.elapsed_s)}</span></td></tr>`
  ).join(''):'<tr><td colspan=4 class="p-6 text-center text-zinc-600">No history yet</td></tr>';
}
async function tick(){try{D=await(await fetch('/api/state')).json()}catch(e){}draw()}
tick();setInterval(tick,5000);
</script></body></html>"""


class H(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def _send(self, code, body, ctype="application/json"):
        b = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(b)))
        self.end_headers()
        self.wfile.write(b)

    def log_message(self, *a):
        pass                                  # don't spam the journal on 5s polls

    def do_GET(self):
        # Route on the PATH only. Exact-matching self.path meant any query
        # string 404'd the dashboard -- a cache-buster, a share link with a
        # tracking param, anything. It also wasted a debugging cycle: every
        # `curl /?cb=...` check returned "not found" and looked like the page
        # had failed to deploy.
        self.path = urllib.parse.urlsplit(self.path).path or "/"
        if self.path == "/":
            return self._send(200, PAGE, "text/html; charset=utf-8")
        if self.path in STATIC:
            path, ctype = STATIC[self.path]
            try:
                with open(path, "rb") as f:
                    return self._send(200, f.read(), ctype)
            except OSError:
                return self._send(404, "")
        if self.path == "/healthz":
            return self._send(200, '{"ok":true}')
        if self.path == "/api/state":
            return self._send(200, json.dumps(state()))
        self._send(404, '{"error":"not found"}')

    def do_POST(self):
        self.path = urllib.parse.urlsplit(self.path).path or "/"
        # ALWAYS drain the request body before responding. On HTTP/1.1 with
        # keep-alive, returning early (404/401) without consuming it leaves
        # unread bytes in the socket, the next request parses them as garbage,
        # and the client sees an empty reply -- which reads as "the server is
        # broken" rather than "you were rejected".
        n = int(self.headers.get("Content-Length", 0) or 0)
        raw = self.rfile.read(n) if n else b""

        if self.path.startswith("/api/forget/"):
            if TOKEN and self.headers.get("Authorization") != f"Bearer {TOKEN}":
                return self._send(401, '{"error":"unauthorized"}')
            name = urllib.parse.unquote(self.path[len("/api/forget/"):])
            c = db()
            n = c.execute("DELETE FROM snapshot WHERE machine=?", (name,)).rowcount
            c.commit(); c.close()
            return self._send(200, json.dumps({"forgot": name, "rows": n}))
        if self.path != "/api/report":
            return self._send(404, '{"error":"not found"}')
        if TOKEN and self.headers.get("Authorization") != f"Bearer {TOKEN}":
            return self._send(401, '{"error":"unauthorized"}')
        try:
            d = json.loads(raw or b"{}")
            record(d["machine"], d.get("app", "?"), d.get("jobs", []))
        except Exception as e:                # noqa: BLE001
            return self._send(400, json.dumps({"error": str(e)}))
        self._send(200, '{"ok":true}')


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--bind", default="127.0.0.1")
    ap.add_argument("--port", type=int, default=8090)
    a = ap.parse_args()
    db().close()
    print(f"renderdeck-server on {a.bind}:{a.port} (token {'set' if TOKEN else 'DISABLED'})",
          flush=True)
    ThreadingHTTPServer((a.bind, a.port), H).serve_forever()


if __name__ == "__main__":
    main()
