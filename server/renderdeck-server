<script>
const BADGE_BASE = "w-fit self-start sm:self-auto shrink-0 whitespace-nowrap px-3 py-1 sm:px-4 sm:py-1.5 rounded-full text-xs sm:text-sm font-semibold inline-flex items-center gap-2 border";
let D={machines:[],history:[],active:0};
const esc=s=>String(s??'').replace(/[<>&"]/g,c=>({'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'}[c]));
const base=s=>String(s||'').split(/[\\/]/).pop();
const dur=s=>{s=Math.round(s||0);const h=s/3600|0,m=(s%3600)/60|0;
  return h?`${h}h ${m}m`:m?`${m}m ${s%60}s`:`${s}s`};
const clock=t=>new Date(t*1000).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});

function draw(){
  const hosts=new Set(D.machines.filter(m=>m.online).map(m=>m.machine));
  const on=hosts.size;
  document.getElementById('badgeText').textContent =
    D.active?`${D.active} rendering`:on?`Idle - ${on} online`:'No machines online';
  // Only the COLOUR varies. The layout classes have to be repeated here because
  // assigning className replaces the whole attribute -- an earlier version
  // rebuilt just the colours and silently threw away the responsive layout, so
  // the header looked right in the markup and wrong in the browser.
  document.getElementById('badge').className = BADGE_BASE + " " +
    (D.active?"bg-orange-500/10 border-orange-500/50 text-orange-400"
      :on?"bg-emerald-500/10 border-emerald-500/50 text-emerald-400"
         :"bg-zinc-500/10 border-zinc-500/50 text-zinc-400");

  const byMachine={};
  D.machines.forEach(r=>{(byMachine[r.machine]=byMachine[r.machine]||[]).push(r)});
  const names=Object.keys(byMachine).sort();
  document.getElementById('machines').innerHTML = names.length?names.map(name=>{
    const rows=byMachine[name];
    const anyOn=rows.some(r=>r.online);
    const busy=rows.reduce((n,r)=>n+r.jobs.filter(j=>['rendering','stalled'].includes(j.state)).length,0);
    return `<div class="bg-zinc-950 border border-zinc-800 rounded p-3">
      <div class="flex items-center gap-2">
        <div class="w-2 h-2 rounded-full ${anyOn?(busy?'bg-orange-500 animate-pulse':'bg-emerald-500'):'bg-zinc-600'}"></div>
        <span class="font-medium text-white">${esc(name)}</span>
        ${busy?`<span class="ml-auto text-xs text-orange-400">${busy} rendering</span>`:''}
      </div>
      <div class="mt-2 pl-4 space-y-1">${rows.map(r=>{
        const b=r.jobs.filter(j=>['rendering','stalled'].includes(j.state)).length;
        return `<div class="flex items-center gap-2 text-xs">
          <div class="w-1.5 h-1.5 rounded-full ${r.online?(b?'bg-orange-500':'bg-emerald-600'):'bg-zinc-700'}"></div>
          <span class="text-zinc-400">${esc(r.app)}</span>
          <span class="ml-auto text-zinc-600">${r.online?(b?b+' rendering':'idle'):'offline '+dur(r.age_s)}</span>
        </div>`}).join('')}</div>
    </div>`}).join(''):'<div class="text-sm text-zinc-500">No machines reporting</div>';

  const jobs=[];
  D.machines.forEach(m=>m.jobs.filter(j=>['rendering','stalled'].includes(j.state))
    .forEach(j=>jobs.push({...j,machine:m.machine,app:m.app})));
  document.getElementById('qc').textContent=jobs.length;
  document.getElementById('queue').innerHTML = jobs.length?jobs.map(j=>{
    const st=j.state==='stalled';
    return `<tr class="hover:bg-zinc-950/50">
      <td class="p-3"><div class="font-medium text-white truncate max-w-[15rem]">${esc(j.name)}</div>
